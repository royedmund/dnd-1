2670 IF VAL(MID$(D$(NY),NX+1,1))=3 THEN TY=NY:TX=NX:TV=4:GOSUB 8200:ZZ=ZZ+1
2680 IF VAL(MID$(D$(NY),NX+1,1))<>2 THEN 2720
2690 RP=20:GOSUB 8000
2700 IF RV<=ST(5) THEN TY=NY:TX=NX:TV=0:GOSUB 8200:ZZ=ZZ+1

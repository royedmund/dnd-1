10 REM TTY300 - MODEL III TO PDP-11 SERIAL TERMINAL
20 REM LDOS 5.1 / LBASIC - 300 BAUD - 8N1
30 REM DIRECT UART I/O - NO *CL DRIVER REQUIRED
40 REM R. ANTAW / CHATGPT - DND1 PROJECT 2026
50 DEFINT A-Z
60 CLS
70 PRINT "TTY300 - PI PDP-11/70 TERMINAL"
80 PRINT "300 BAUD  8 DATA  NO PARITY  1 STOP"
90 PRINT "REMOTE ECHO - TYPE TO THE PDP-11"
100 PRINT "BREAK RETURNS TO BASIC"
110 REM DO NOT RUN WITH RS232T/DVR ACTIVE
120 REM RESET UART AND SET BOTH BAUD CLOCKS
130 OUT 232,0
140 OUT 233,85
150 REM WORD=8, ONE STOP, NO PARITY, DTR/RTS ON
160 OUT 234,104
170 REM FIRST CHECK RECEIVED DATA TO REDUCE LOSS
180 S=INP(234)
190 IF (S AND 128)=0 THEN 220
200 C=INP(235):GOSUB 350
210 GOTO 180
220 REM NONBLOCKING KEYBOARD CHECK
230 K$=INKEY$
240 IF K$="" THEN 180
250 B=ASC(K$)
260 IF B=1 THEN 330
270 REM LEFT ARROW/BACKSPACE SENDS DEL
280 IF B=8 THEN B=127
290 IF B=10 THEN B=13
300 REM WAIT UNTIL UART TRANSMITTER READY
310 IF (INP(234) AND 64)=0 THEN 310
320 OUT 235,B:GOTO 180
330 PRINT:PRINT "TTY300 ENDED"
340 END
350 REM RECEIVE: IGNORE LF AFTER HOST CR
360 IF C=10 THEN RETURN
370 IF C=13 THEN PRINT:RETURN
380 IF C=8 OR C=127 THEN PRINT CHR$(8);" ";CHR$(8);:RETURN
390 IF C=9 THEN PRINT "    ";:RETURN
400 IF C<32 OR C>126 THEN RETURN
410 PRINT CHR$(C);
420 RETURN
